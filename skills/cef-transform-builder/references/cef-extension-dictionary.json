{
  "_note": "Common CEF extension short keys (ArcSight/OpenText 'CEF Key Names for Event Producers'). Emit the short key on the wire; full_name is the canonical ArcSight field. Prefer a dictionary key when one fits; otherwise use the paired custom slots (cs*/cn*/cfp*/flex*) WITH their *Label. CEF permits arbitrary extension keys, so keys not listed here are allowed (the validator only warns).",
  "keys": {
    "src":        {"full_name": "sourceAddress",          "type": "IPv4"},
    "dst":        {"full_name": "destinationAddress",      "type": "IPv4"},
    "spt":        {"full_name": "sourcePort",              "type": "Integer"},
    "dpt":        {"full_name": "destinationPort",         "type": "Integer"},
    "smac":       {"full_name": "sourceMacAddress",        "type": "MAC"},
    "dmac":       {"full_name": "destinationMacAddress",   "type": "MAC"},
    "proto":      {"full_name": "transportProtocol",       "type": "String", "max": 31},
    "app":        {"full_name": "applicationProtocol",     "type": "String", "max": 31},
    "in":         {"full_name": "bytesIn",                 "type": "Integer"},
    "out":        {"full_name": "bytesOut",                "type": "Integer"},
    "shost":      {"full_name": "sourceHostName",          "type": "String", "max": 1023},
    "dhost":      {"full_name": "destinationHostName",     "type": "String", "max": 1023},
    "dvchost":    {"full_name": "deviceHostName",          "type": "String", "max": 100},
    "dvc":        {"full_name": "deviceAddress",           "type": "IPv4"},
    "suser":      {"full_name": "sourceUserName",          "type": "String", "max": 1023},
    "duser":      {"full_name": "destinationUserName",     "type": "String", "max": 1023},
    "suid":       {"full_name": "sourceUserId",            "type": "String", "max": 1023},
    "duid":       {"full_name": "destinationUserId",       "type": "String", "max": 1023},
    "spriv":      {"full_name": "sourceUserPrivileges",    "type": "String", "max": 1023},
    "dpriv":      {"full_name": "destinationUserPrivileges","type": "String", "max": 1023},
    "act":        {"full_name": "deviceAction",            "type": "String", "max": 63},
    "outcome":    {"full_name": "eventOutcome",            "type": "String", "max": 63},
    "reason":     {"full_name": "Reason",                  "type": "String", "max": 1023},
    "msg":        {"full_name": "message",                 "type": "String", "max": 1023},
    "cat":        {"full_name": "deviceEventCategory",     "type": "String", "max": 1023},
    "cnt":        {"full_name": "baseEventCount",          "type": "Integer"},
    "request":    {"full_name": "requestUrl",              "type": "String", "max": 1023},
    "requestMethod": {"full_name": "requestMethod",        "type": "String", "max": 1023},
    "requestClientApplication": {"full_name": "requestClientApplication", "type": "String", "max": 1023},
    "rt":         {"full_name": "deviceReceiptTime",       "type": "Timestamp"},
    "start":      {"full_name": "startTime",               "type": "Timestamp"},
    "end":        {"full_name": "endTime",                 "type": "Timestamp"},
    "art":        {"full_name": "agentReceiptTime",        "type": "Timestamp"},
    "fname":      {"full_name": "fileName",                "type": "String", "max": 1023},
    "fsize":      {"full_name": "fileSize",                "type": "Integer"},
    "filePath":   {"full_name": "filePath",                "type": "String", "max": 1023},
    "fileHash":   {"full_name": "fileHash",                "type": "String", "max": 255},
    "dproc":      {"full_name": "destinationProcessName",  "type": "String", "max": 1023},
    "sproc":      {"full_name": "sourceProcessName",       "type": "String", "max": 1023},
    "dpid":       {"full_name": "destinationProcessId",    "type": "Integer"},
    "spid":       {"full_name": "sourceProcessId",         "type": "Integer"}
  },
  "custom_slots": {
    "cs1..cs6":   {"label": "cs<N>Label",              "type": "String", "max": 4000},
    "cn1..cn3":   {"label": "cn<N>Label",              "type": "Long"},
    "cfp1..cfp4": {"label": "cfp<N>Label",             "type": "Float"},
    "flexString1..2": {"label": "flexString<N>Label",  "type": "String", "max": 1023},
    "deviceCustomDate1..2": {"label": "deviceCustomDate<N>Label", "type": "Timestamp"},
    "flexDate1":  {"label": "flexDate1Label",          "type": "Timestamp"},
    "c6a1..c6a4": {"label": "c6a<N>Label",             "type": "IPv6"}
  }
}
